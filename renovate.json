{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["baragoon"],
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump",
      "groupName": "go toolchain"
    }
  ]
}