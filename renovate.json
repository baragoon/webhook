{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["baragoon"],
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "osvVulnerabilityAlerts": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/build\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)(?: versioning=(?<versioning>.*?))?\\s+go-version: \\[(?<currentValue>\\d+\\.\\d+\\.\\d+)\\]"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump",
      "groupName": "go toolchain"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["go"],
      "groupName": "go toolchain"
    }
  ]
}